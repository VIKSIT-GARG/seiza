#!/usr/bin/env bash
# rice-backup — Automated backup tool for CachyOS + Niri desktop configuration
set -euo pipefail

BACKUP_ROOT="${HOME}/.config/rice_backups"
TIMESTAMP="$(date +'%Y%m%d_%H%M%S')"
BACKUP_DIR="${BACKUP_ROOT}/backup_${TIMESTAMP}"

echo "==> Creating timestamped desktop rice backup in: ${BACKUP_DIR}"
mkdir -p "${BACKUP_DIR}"

CONFIG_DIRS=(
    "niri"
    "noctalia"
    "alacritty"
    "fish"
    "fastfetch"
    "gtk-3.0"
    "gtk-4.0"
    "fontconfig"
    "fuzzel"
    "micro"
    "zathura"
    "btop"
    "cava"
    "xdg-desktop-portal"
    "environment.d"
)

for dir in "${CONFIG_DIRS[@]}"; do
    if [ -d "${HOME}/.config/${dir}" ]; then
        echo " -> Backing up ~/.config/${dir}..."
        cp -a "${HOME}/.config/${dir}" "${BACKUP_DIR}/"
    fi
done

for file in starship.toml kdeglobals QtProject.conf cyberglass_theme_mode.txt; do
    if [ -f "${HOME}/.config/${file}" ]; then
        echo " -> Backing up ~/.config/${file}..."
        cp -a "${HOME}/.config/${file}" "${BACKUP_DIR}/"
    fi
done

if [ -d "${HOME}/.local/state/noctalia" ]; then
    echo " -> Backing up ~/.local/state/noctalia..."
    mkdir -p "${BACKUP_DIR}/local_state_noctalia"
    cp -a "${HOME}/.local/state/noctalia/"*.toml "${BACKUP_DIR}/local_state_noctalia/" 2>/dev/null || true
fi

cat <<METADATA > "${BACKUP_DIR}/backup_info.json"
{
  "timestamp": "${TIMESTAMP}",
  "created_at": "$(date -Iseconds)",
  "niri_version": "$(niri --version 2>/dev/null || echo 'unknown')",
  "noctalia_version": "$(noctalia --version 2>/dev/null || echo 'unknown')"
}
METADATA

echo "==> Backup complete: ${BACKUP_DIR}"
ls -ld "${BACKUP_ROOT}"/backup_* 2>/dev/null | tail -n 5
