#!/usr/bin/env python3
"""seiza. — Unified personal operating environment CLI entrypoint."""

import sys
from pathlib import Path

LIB_ROOT = Path.home() / ".local/lib"
if str(LIB_ROOT) not in sys.path:
    sys.path.insert(0, str(LIB_ROOT))

from seiza.cli import main

if __name__ == "__main__":
    raise SystemExit(main())
