#!/usr/bin/env bash
# ────────────── seiza. Dual-GPU Telemetry & Logger ──────────────

set -euo pipefail

CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
MAGENTA="\033[1;35m"
BOLD="\033[1m"
RESET="\033[0m"

print_gpu_report() {
    clear 2>/dev/null || true
    echo -e "${MAGENTA}──────────────────────────────────────────────────────${RESET}"
    echo -e "${BOLD}         seiza. // Dual-GPU Telemetry Monitor         ${RESET}"
    echo -e "${MAGENTA}──────────────────────────────────────────────────────${RESET}"
    echo ""

    # 1. AMD Integrated GPU (Dynamic amdgpu hwmon probe)
    echo -e "${MAGENTA}--- [0] AMD Integrated Graphics (amdgpu) ---${RESET}"
    amd_temp=""
    for h in /sys/class/hwmon/hwmon*; do
        if [ "$(cat "$h/name" 2>/dev/null || true)" = "amdgpu" ] && [ -r "$h/temp1_input" ]; then
            amd_temp=$(($(cat "$h/temp1_input") / 1000))
            break
        fi
    done
    if [ -n "$amd_temp" ]; then
        echo -e "  ${BOLD}Temperature:${RESET}    ${GREEN}${amd_temp}°C${RESET}"
    fi
    echo -e "  ${BOLD}Driver:${RESET}         amdgpu (Kernel Module)"
    echo -e "  ${BOLD}Vulkan/GL:${RESET}      RADV / Mesa (GL 4.6 / Vulkan 1.3)"

    echo ""
    # 2. NVIDIA Discrete GPU
    echo -e "${CYAN}--- [1] NVIDIA Discrete GPU ---${RESET}"
    if command -v nvidia-smi >/dev/null 2>&1; then
        # Query metrics via nvidia-smi
        gpu_info=$(nvidia-smi --query-gpu=driver_version,pstate,temperature.gpu,utilization.gpu,utilization.memory,memory.total,memory.used,memory.free,power.draw,power.limit,clocks.current.graphics,clocks.current.memory,persistence_mode --format=csv,noheader,nounits 2>/dev/null || echo "")
        
        if [ -n "$gpu_info" ]; then
            IFS=',' read -r driver pstate temp util_gpu util_mem mem_tot mem_used mem_free pwr pwr_lim clk_gfx clk_mem persist <<< "$gpu_info"
            
            # Clean whitespace
            driver=$(echo "$driver" | xargs)
            pstate=$(echo "$pstate" | xargs)
            temp=$(echo "$temp" | xargs)
            util_gpu=$(echo "$util_gpu" | xargs)
            util_mem=$(echo "$util_mem" | xargs)
            mem_tot=$(echo "$mem_tot" | xargs)
            mem_used=$(echo "$mem_used" | xargs)
            mem_free=$(echo "$mem_free" | xargs)
            pwr=$(echo "$pwr" | xargs)
            pwr_lim=$(echo "$pwr_lim" | xargs)
            clk_gfx=$(echo "$clk_gfx" | xargs)
            clk_mem=$(echo "$clk_mem" | xargs)
            persist=$(echo "$persist" | xargs)

            echo -e "  ${BOLD}Driver Version:${RESET} ${driver} | Performance State: ${pstate}"
            
            # Temp coloring
            if [ "$temp" -gt 80 ]; then
                t_color="$RED"
            elif [ "$temp" -gt 65 ]; then
                t_color="$YELLOW"
            else
                t_color="$GREEN"
            fi
            echo -e "  ${BOLD}Temperature:${RESET}    ${t_color}${temp}°C${RESET}"
            echo -e "  ${BOLD}GPU Compute:${RESET}    ${util_gpu}% | Memory Controller: ${util_mem}%"
            echo -e "  ${BOLD}VRAM Usage:${RESET}     ${mem_used} MiB / ${mem_tot} MiB (${mem_free} MiB free)"
            echo -e "  ${BOLD}Power Draw:${RESET}     ${pwr} W (Limit: ${pwr_lim} W)"
            echo -e "  ${BOLD}Clocks:${RESET}         Core: ${clk_gfx} MHz | VRAM: ${clk_mem} MHz"
            
            if [ "$persist" = "Enabled" ]; then
                echo -e "  ${BOLD}Persistence:${RESET}    ${GREEN}Enabled${RESET}"
            else
                echo -e "  ${BOLD}Persistence:${RESET}    ${YELLOW}Disabled (Run 'cachyos-stabilize' to enable)${RESET}"
            fi
        else
            echo -e "  ${YELLOW}NVIDIA GPU is currently asleep or powered down.${RESET}"
        fi

        # Process list on NVIDIA GPU
        echo ""
        echo -e "${BOLD}Active GPU Processes:${RESET}"
        procs=$(nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader,nounits 2>/dev/null || true)
        if [ -n "$procs" ]; then
            echo "$procs" | awk -F',' '{ printf "  PID %-8s | %-30s | %s MiB\n", $1, $2, $3 }'
        else
            echo "  None (NVIDIA GPU running in low-power Wayland offload mode)"
        fi
    else
        echo -e "  ${RED}nvidia-smi not found!${RESET}"
    fi

    echo ""
    echo -e "${CYAN}======================================================${RESET}"
}

if [ "${1:-}" = "-w" ] || [ "${1:-}" = "--watch" ]; then
    while true; do
        print_gpu_report
        echo -e "Refreshing every 1s... Press Ctrl+C to exit."
        sleep 1
    done
else
    print_gpu_report
    echo -e "Tip: Run ${CYAN}gpu-log -w${RESET} for real-time 1-second live telemetry."
fi
