#!/usr/bin/env bash
# ────────────── seiza. Named Configuration Snapshot Tool ──────────────

set -euo pipefail

BACKUP_ROOT="${HOME}/.config/rice_backups"
CYAN="\033[1;36m"
GREEN="\033[1;32m"
YELLOW="\033[1;33m"
RED="\033[1;31m"
BOLD="\033[1m"
RESET="\033[0m"

mkdir -p "$BACKUP_ROOT"

usage() {
    echo -e "${CYAN}seiza. Configuration Snapshot Tool${RESET}"
    echo "Usage:"
    echo "  snap <name>               Create a new named snapshot (e.g., snap clean-v1)"
    echo "  snap save <name>          Create a new named snapshot"
    echo "  snap auto                 Create an automated daily snapshot (prunes old autos)"
    echo "  snap list                 List all saved snapshots"
    echo "  snap prune [days]         Prune auto snapshots older than N days (default: 7)"
    echo "  snap restore <name>       Restore configurations from a snapshot"
    echo "  snap delete <name>        Delete a snapshot"
    exit 0
}

cmd="${1:-}"

if [ -z "$cmd" ] || [ "$cmd" = "-h" ] || [ "$cmd" = "--help" ]; then
    usage
fi

take_snapshot() {
    local name="$1"
    local stamp
    stamp=$(date +%Y%m%d_%H%M%S)
    local dest="$BACKUP_ROOT/snap_${name}_${stamp}"
    echo -e "${CYAN}Creating snapshot: ${dest}...${RESET}"

    mkdir -p "$dest/.config" "$dest/.local/bin" "$dest/.local/state/noctalia"

    for dir in niri noctalia fish alacritty fastfetch gtk-3.0 gtk-4.0 fontconfig fuzzel micro zathura btop cava opencode; do
        if [ -d "${HOME}/.config/$dir" ]; then
            cp -r "${HOME}/.config/$dir" "$dest/.config/"
        fi
    done
    for file in starship.toml kdeglobals QtProject.conf cyberglass_theme_mode.txt; do
        if [ -f "${HOME}/.config/$file" ]; then
            cp -a "${HOME}/.config/$file" "$dest/.config/"
        fi
    done

    cp -r "${HOME}/.local/state/noctalia"/* "$dest/.local/state/noctalia/" 2>/dev/null || true
    cp -r "${HOME}/.local/bin"/* "$dest/.local/bin/" 2>/dev/null || true

    echo -e "${GREEN}✓ Snapshot saved successfully!${RESET}"
    echo -e "  Name: ${BOLD}snap_${name}_${stamp}${RESET}"
    echo -e "  Location: ${dest}"
}

case "$cmd" in
    list|ls)
        echo -e "${CYAN}Available Snapshots in ${BACKUP_ROOT}:${RESET}"
        if [ -z "$(ls -A "$BACKUP_ROOT" 2>/dev/null)" ]; then
            echo "  (No snapshots found)"
            exit 0
        fi
        for d in "$BACKUP_ROOT"/*; do
            if [ -d "$d" ]; then
                base=$(basename "$d")
                size=$(du -sh "$d" | awk '{print $1}')
                date_str=$(date -r "$d" "+%Y-%m-%d %H:%M:%S")
                echo -e "  ➜ ${BOLD}${base}${RESET} (${size}, ${date_str})"
            fi
        done
        echo ""
        echo -e "Restore any snapshot using: ${CYAN}snap restore <name>${RESET}"
        ;;

    restore)
        tag="${2:-}"
        if [ -z "$tag" ]; then
            echo -e "${RED}Error: Please specify the snapshot name to restore.${RESET}"
            echo "Run 'snap list' to view available snapshots."
            exit 1
        fi
        
        target=""
        if [ -d "$BACKUP_ROOT/$tag" ]; then
            target="$BACKUP_ROOT/$tag"
        else
            # Try fuzzy match
            for d in "$BACKUP_ROOT"/*"$tag"*; do
                if [ -d "$d" ]; then
                    target="$d"
                    break
                fi
            done
        fi

        if [ -z "$target" ] || [ ! -d "$target" ]; then
            echo -e "${RED}Error: Snapshot '${tag}' not found in ${BACKUP_ROOT}${RESET}"
            exit 1
        fi

        echo -e "${YELLOW}Restoring configurations from: ${target}${RESET}"
        cp -r "$target"/.config/* "${HOME}/.config/" 2>/dev/null || true
        cp -r "$target"/.local/bin/* "${HOME}/.local/bin/" 2>/dev/null || true
        cp -r "$target"/.local/state/noctalia/* "${HOME}/.local/state/noctalia/" 2>/dev/null || true

        echo -e "${GREEN}✓ Snapshot '${tag}' restored successfully!${RESET}"
        echo -e "Reloading desktop environment..."
        niri msg action load-config-file 2>/dev/null || true
        noctalia msg templates-apply 2>/dev/null || true
        ;;

    delete|rm)
        tag="${2:-}"
        if [ -z "$tag" ]; then
            echo -e "${RED}Error: Specify snapshot name to delete.${RESET}"
            exit 1
        fi
        target="$BACKUP_ROOT/$tag"
        if [ -d "$target" ]; then
            rm -rf "$target"
            echo -e "${GREEN}✓ Snapshot '${tag}' deleted.${RESET}"
        else
            echo -e "${RED}Snapshot '${tag}' not found.${RESET}"
        fi
        ;;

    prune)
        days="${2:-7}"
        echo -e "${CYAN}Pruning automated snapshots older than ${days} days...${RESET}"
        find "$BACKUP_ROOT" -maxdepth 1 -type d -name "snap_auto_*" -mtime +"${days}" -exec rm -rf {} + 2>/dev/null || true
        echo -e "${GREEN}✓ Pruning complete.${RESET}"
        ;;

    auto)
        take_snapshot "auto"
        # Keep automated snapshots pruned to last 7 days
        find "$BACKUP_ROOT" -maxdepth 1 -type d -name "snap_auto_*" -mtime +7 -exec rm -rf {} + 2>/dev/null || true
        ;;

    save)
        name="${2:-}"
        if [ -z "$name" ]; then
            echo -e "${RED}Error: Please specify a name for the snapshot (e.g. snap save clean-v3).${RESET}"
            exit 1
        fi
        take_snapshot "$name"
        ;;

    *)
        # Default shorthand: snap <name> -> snap save <name>
        take_snapshot "$cmd"
        ;;
esac
